[Unit]
Description=Team Tracker
After=network.target

[Service]
Type=simple
User=team-tracker
Group=team-tracker
WorkingDirectory=/opt/team-tracker
EnvironmentFile=/etc/team-tracker.env
ExecStart=/usr/bin/node /opt/team-tracker/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/team-tracker
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
